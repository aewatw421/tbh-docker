# TBH Wine 版 Compose 环境变量样例
# 复制为 .env 后按需填写；.env 已被 .gitignore 忽略，不会进仓库。

# ---- 镜像 ----
# TBH_WINE_IMAGE=ghcr.io/aewatw421/tbh-wine:latest
# TBH_MEM_LIMIT=5g
# TBH_CPUS=4
# TZ=Asia/Shanghai

# ---- 实例 1 ----
STEAM_USER_1=
STEAM_PASS_1=
VNC_PASSWORD_1=

# ---- 实例 2（multi profile）----
STEAM_USER_2=
STEAM_PASS_2=
VNC_PASSWORD_2=

# ---- 实例 3（multi profile）----
STEAM_USER_3=
STEAM_PASS_3=
VNC_PASSWORD_3=

# 说明：
# - STEAM_USER/PASS 留空 = 首次启动在 noVNC 里手动登录一次（票据持久化到 ./data/instN，之后免登录）
# - 建议给每个实例都设置 VNC_PASSWORD（容器暴露在局域网/公网时必设）
# - 手机令牌（Steam Guard App）开启的账号，自动登录可能需要一次确认；之后 ssfn 票据可复用
